{
  "$defs": {
    "ExtensionObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonValue": {}
  },
  "$id": "urn:pipeline:contract:AssemblyManifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Assembly manifest recording ordered chunks and continuity checks.",
  "properties": {
    "assembled_at": {
      "format": "date-time",
      "title": "Assembled At",
      "type": "string"
    },
    "assembler_version": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Assembler Version",
      "type": "string"
    },
    "assembly_artifact_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Assembly Artifact Id",
      "type": "string"
    },
    "chunk_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^\\S+$",
        "type": "string"
      },
      "title": "Chunk Ids",
      "type": "array"
    },
    "chunk_manifest_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^\\S+$",
        "type": "string"
      },
      "title": "Chunk Manifest Ids",
      "type": "array"
    },
    "composition_artifact_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Composition Artifact Id",
      "type": "string"
    },
    "continuity_checks_passed": {
      "default": true,
      "title": "Continuity Checks Passed",
      "type": "boolean"
    },
    "continuity_failures": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "pattern": "^\\S(?:.*\\S)?$",
        "type": "string"
      },
      "title": "Continuity Failures",
      "type": "array"
    },
    "cut_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Cut Id",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/ExtensionObject"
    },
    "output_artifact_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Output Artifact Id",
      "type": "string"
    },
    "output_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Output Sha256",
      "type": "string"
    },
    "output_size_bytes": {
      "minimum": 0,
      "title": "Output Size Bytes",
      "type": "integer"
    },
    "output_uri": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Output Uri",
      "type": "string"
    },
    "render_profile_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Render Profile Id",
      "type": "string"
    },
    "schema_version": {
      "const": "assembly-manifest.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "total_duration_frames": {
      "minimum": 1,
      "title": "Total Duration Frames",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "assembly_artifact_id",
    "cut_id",
    "composition_artifact_id",
    "render_profile_id",
    "total_duration_frames",
    "output_artifact_id",
    "output_uri",
    "output_sha256",
    "output_size_bytes",
    "assembler_version",
    "assembled_at"
  ],
  "title": "AssemblyManifest",
  "type": "object",
  "x-contract-schema-version": "assembly-manifest.v1"
}
