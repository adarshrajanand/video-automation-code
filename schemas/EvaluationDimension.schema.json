{
  "$defs": {
    "ExtensionObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "FailureCode": {
      "description": "Namespaced failure codes registered for recovery decisions.",
      "enum": [
        "EXEC.VALIDATION",
        "EXEC.AUTHENTICATION",
        "EXEC.AUTHORIZATION",
        "EXEC.RATE_LIMIT",
        "EXEC.QUOTA",
        "EXEC.TRANSIENT_PROVIDER",
        "EXEC.PERMANENT_PROVIDER",
        "EXEC.INTERNAL",
        "EXEC.TIMEOUT_UNKNOWN",
        "MEDIA.DECODE_ERROR",
        "MEDIA.OUTPUT_PROFILE",
        "MEDIA.TIMELINE_INVALID",
        "MEDIA.TECHNICAL_INTEGRITY",
        "QUALITY.SCHEMA_INVALID",
        "QUALITY.GENERIC",
        "QUALITY.UNSUPPORTED_CLAIM",
        "QUALITY.NUMERIC_CONTRADICTION",
        "QUALITY.TTS_OMISSION",
        "QUALITY.TTS_PRONUNCIATION",
        "QUALITY.VISUAL_MISMATCH",
        "QUALITY.MISSING_ASSET",
        "QUALITY.PROVENANCE_MISSING",
        "QUALITY.CAPTION_OVERFLOW",
        "QUALITY.AUDIO_DECODE",
        "MEDIA.RENDER_CORRUPT",
        "MEDIA.AUDIO_VIDEO_DRIFT",
        "QUALITY.REPEATED_FAILURE",
        "RIGHTS.LICENSE_UNCERTAIN",
        "HUMAN.REVIEW_REQUIRED",
        "POLICY.BUDGET_EXCEEDED",
        "POLICY.PROHIBITED_CONTENT",
        "CONFIG.UNKNOWN_STAGE"
      ],
      "title": "FailureCode",
      "type": "string"
    },
    "JsonValue": {},
    "Severity": {
      "description": "Severity used by normalized errors and quality evidence.",
      "enum": [
        "INFO",
        "MINOR",
        "MAJOR",
        "CRITICAL"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "$id": "urn:pipeline:contract:EvaluationDimension",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One named score, threshold, and evidence set within an evaluation.",
  "properties": {
    "details": {
      "$ref": "#/$defs/ExtensionObject"
    },
    "evidence_refs": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^\\S+$",
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "failure_codes": {
      "items": {
        "$ref": "#/$defs/FailureCode"
      },
      "title": "Failure Codes",
      "type": "array"
    },
    "name": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Name",
      "type": "string"
    },
    "schema_version": {
      "const": "evaluation-dimension.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Score"
    },
    "severity": {
      "$ref": "#/$defs/Severity",
      "default": "INFO"
    },
    "threshold": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Threshold"
    }
  },
  "required": [
    "schema_version",
    "name"
  ],
  "title": "EvaluationDimension",
  "type": "object",
  "x-contract-schema-version": "evaluation-dimension.v1"
}
