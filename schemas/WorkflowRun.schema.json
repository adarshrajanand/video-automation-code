{
  "$defs": {
    "RunStatus": {
      "description": "Lifecycle of one workflow run.",
      "enum": [
        "CREATED",
        "RUNNING",
        "WAITING_HUMAN",
        "WAITING_RETRY",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "$id": "urn:pipeline:contract:WorkflowRun",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One execution of a workflow definition.",
  "properties": {
    "content_package_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Content Package Id",
      "type": "string"
    },
    "created_timestamp_micro": {
      "format": "date-time",
      "title": "Created Timestamp Micro",
      "type": "string"
    },
    "effective_config_hash": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Effective Config Hash",
      "type": "string"
    },
    "effective_config_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Effective Config Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Run Id",
      "type": "string"
    },
    "run_key": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Run Key",
      "type": "string"
    },
    "schema_version": {
      "const": "workflow-run.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "updated_timestamp_micro": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated Timestamp Micro"
    },
    "workflow_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Workflow Id",
      "type": "string"
    },
    "workflow_version": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Workflow Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "created_timestamp_micro",
    "run_id",
    "run_key",
    "workflow_id",
    "workflow_version",
    "effective_config_id",
    "effective_config_hash",
    "status",
    "content_package_id"
  ],
  "title": "WorkflowRun",
  "type": "object",
  "x-contract-schema-version": "workflow-run.v2"
}
