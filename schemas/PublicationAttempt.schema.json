{
  "$defs": {
    "ExtensionObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "FailureCategory": {
      "description": "Stable failure categories from the canonical failure-code registry.",
      "enum": [
        "VALIDATION",
        "AUTHENTICATION",
        "AUTHORIZATION",
        "RATE_LIMIT",
        "QUOTA",
        "TRANSIENT",
        "PERMANENT",
        "UNKNOWN_OUTCOME",
        "MEDIA",
        "QUALITY",
        "BUDGET",
        "CONFIGURATION",
        "HUMAN_REVIEW",
        "POLICY",
        "INTERNAL"
      ],
      "title": "FailureCategory",
      "type": "string"
    },
    "FailureCode": {
      "description": "Namespaced failure codes registered for recovery decisions.",
      "enum": [
        "EXEC.VALIDATION",
        "EXEC.AUTHENTICATION",
        "EXEC.AUTHORIZATION",
        "EXEC.RATE_LIMIT",
        "EXEC.QUOTA",
        "EXEC.TRANSIENT_PROVIDER",
        "EXEC.PERMANENT_PROVIDER",
        "EXEC.INTERNAL",
        "EXEC.TIMEOUT_UNKNOWN",
        "MEDIA.DECODE_ERROR",
        "MEDIA.OUTPUT_PROFILE",
        "MEDIA.TIMELINE_INVALID",
        "MEDIA.TECHNICAL_INTEGRITY",
        "QUALITY.SCHEMA_INVALID",
        "QUALITY.GENERIC",
        "QUALITY.UNSUPPORTED_CLAIM",
        "QUALITY.NUMERIC_CONTRADICTION",
        "QUALITY.TTS_OMISSION",
        "QUALITY.TTS_PRONUNCIATION",
        "QUALITY.VISUAL_MISMATCH",
        "QUALITY.MISSING_ASSET",
        "QUALITY.PROVENANCE_MISSING",
        "QUALITY.CAPTION_OVERFLOW",
        "QUALITY.AUDIO_DECODE",
        "MEDIA.RENDER_CORRUPT",
        "MEDIA.AUDIO_VIDEO_DRIFT",
        "QUALITY.REPEATED_FAILURE",
        "RIGHTS.LICENSE_UNCERTAIN",
        "HUMAN.REVIEW_REQUIRED",
        "POLICY.BUDGET_EXCEEDED",
        "POLICY.PROHIBITED_CONTENT",
        "CONFIG.UNKNOWN_STAGE"
      ],
      "title": "FailureCode",
      "type": "string"
    },
    "JsonValue": {},
    "NormalizedError": {
      "additionalProperties": false,
      "description": "Provider- and stage-neutral failure explanation.\n\n``category`` must agree with the canonical category registered for\n``code``. Reconciliation is explicit so unknown external outcomes cannot be\nmistaken for clean failures.",
      "properties": {
        "category": {
          "$ref": "#/$defs/FailureCategory"
        },
        "code": {
          "$ref": "#/$defs/FailureCode"
        },
        "message": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Message",
          "type": "string"
        },
        "provider_status": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Status"
        },
        "reconciliation_required": {
          "default": false,
          "title": "Reconciliation Required",
          "type": "boolean"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "safe_details": {
          "$ref": "#/$defs/ExtensionObject"
        },
        "schema_version": {
          "const": "normalized-error.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "default": "MAJOR"
        }
      },
      "required": [
        "schema_version",
        "code",
        "category",
        "retryable",
        "message"
      ],
      "title": "NormalizedError",
      "type": "object"
    },
    "PublicationStatus": {
      "enum": [
        "PENDING",
        "STARTED",
        "SUCCEEDED",
        "FAILED",
        "UNKNOWN"
      ],
      "title": "PublicationStatus",
      "type": "string"
    },
    "Severity": {
      "description": "Severity used by normalized errors and quality evidence.",
      "enum": [
        "INFO",
        "MINOR",
        "MAJOR",
        "CRITICAL"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "$id": "urn:pipeline:contract:PublicationAttempt",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One attempt to publish an approved publication request.",
  "properties": {
    "external_publication_id": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "External Publication Id"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "normalized_error": {
      "anyOf": [
        {
          "$ref": "#/$defs/NormalizedError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provider_operation_id": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Operation Id"
    },
    "publication_attempt_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Publication Attempt Id",
      "type": "string"
    },
    "publication_request_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Publication Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "publication-attempt.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/PublicationStatus"
    }
  },
  "required": [
    "schema_version",
    "publication_attempt_id",
    "publication_request_id",
    "status"
  ],
  "title": "PublicationAttempt",
  "type": "object",
  "x-contract-schema-version": "publication-attempt.v1"
}
