{
  "$defs": {
    "ExtensionObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonValue": {}
  },
  "$id": "urn:pipeline:contract:Evidence",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A piece of evidence extracted from a source snapshot supporting a claim.",
  "properties": {
    "claim_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Claim Id",
      "type": "string"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "end_offset": {
      "minimum": 1,
      "title": "End Offset",
      "type": "integer"
    },
    "evidence_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Evidence Id",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/ExtensionObject"
    },
    "schema_version": {
      "const": "evidence.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "start_offset": {
      "minimum": 0,
      "title": "Start Offset",
      "type": "integer"
    },
    "text_span": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Text Span",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "evidence_id",
    "snapshot_id",
    "claim_id",
    "text_span",
    "start_offset",
    "end_offset",
    "confidence"
  ],
  "title": "Evidence",
  "type": "object",
  "x-contract-schema-version": "evidence.v1"
}
