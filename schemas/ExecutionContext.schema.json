{
  "$id": "urn:pipeline:contract:ExecutionContext",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Execution scope and limits passed to a capability implementation.",
  "properties": {
    "allowed_data_classification": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Allowed Data Classification",
      "type": "string"
    },
    "attempt_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Attempt Id",
      "type": "string"
    },
    "correlation_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Correlation Id",
      "type": "string"
    },
    "effective_config_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Effective Config Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "execution-context.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "stage_instance_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Stage Instance Id",
      "type": "string"
    },
    "timeout_seconds": {
      "minimum": 1,
      "title": "Timeout Seconds",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "stage_instance_id",
    "attempt_id",
    "effective_config_id",
    "correlation_id",
    "timeout_seconds",
    "allowed_data_classification"
  ],
  "title": "ExecutionContext",
  "type": "object",
  "x-contract-schema-version": "execution-context.v1"
}
