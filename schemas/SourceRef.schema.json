{
  "$defs": {
    "ExtensionObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonValue": {},
    "SourceKind": {
      "enum": [
        "STOCK",
        "PUBLIC_DOMAIN",
        "GENERATED",
        "PROCEDURAL",
        "USER_SUPPLIED"
      ],
      "title": "SourceKind",
      "type": "string"
    }
  },
  "$id": "urn:pipeline:contract:SourceRef",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Reference to an external or internal source document.",
  "properties": {
    "author": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author"
    },
    "content_hash": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/SourceKind"
    },
    "metadata": {
      "$ref": "#/$defs/ExtensionObject"
    },
    "published_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published At"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "schema_version": {
      "const": "source-ref.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Source Id",
      "type": "string"
    },
    "title": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Title",
      "type": "string"
    },
    "uri": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Uri",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "source_id",
    "kind",
    "uri",
    "title",
    "retrieved_at",
    "content_hash"
  ],
  "title": "SourceRef",
  "type": "object",
  "x-contract-schema-version": "source-ref.v1"
}
