{
  "$defs": {
    "ExtensionObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonValue": {},
    "RunOverrides": {
      "additionalProperties": false,
      "description": "Caller-supplied changes that still resolve under system policy.",
      "properties": {
        "enabled_optional_stages": {
          "items": {
            "$ref": "#/$defs/StageName"
          },
          "title": "Enabled Optional Stages",
          "type": "array"
        },
        "locale": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locale"
        },
        "max_cost_minor": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Minor"
        },
        "output_profile_ids": {
          "anyOf": [
            {
              "items": {
                "maxLength": 256,
                "minLength": 1,
                "pattern": "^\\S+$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Profile Ids"
        },
        "quality_profile_id": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Profile Id"
        },
        "schema_version": {
          "const": "run-overrides.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "target_duration_seconds": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Duration Seconds"
        },
        "variant_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant Count"
        }
      },
      "required": [
        "schema_version"
      ],
      "title": "RunOverrides",
      "type": "object"
    },
    "StageName": {
      "description": "Canonical stage names from ``registries/stages.yaml``.",
      "enum": [
        "manual_topic",
        "topic_discovery",
        "idea_development",
        "research",
        "script_generation",
        "visual_planning",
        "asset_acquisition",
        "speech_generation",
        "composition",
        "rendering",
        "assembly",
        "short_derivative",
        "technical_content_review",
        "human_approval",
        "publishing",
        "analytics_learning"
      ],
      "title": "StageName",
      "type": "string"
    }
  },
  "$id": "urn:pipeline:contract:EffectiveConfig",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable resolved configuration for one run.",
  "properties": {
    "channel_profile_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Channel Profile Id",
      "type": "string"
    },
    "channel_profile_version": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Channel Profile Version",
      "type": "string"
    },
    "config_hash": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Hash",
      "type": "string"
    },
    "domain_profile_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Domain Profile Id",
      "type": "string"
    },
    "domain_profile_version": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Domain Profile Version",
      "type": "string"
    },
    "effective_config_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Effective Config Id",
      "type": "string"
    },
    "resolved_values": {
      "$ref": "#/$defs/ExtensionObject"
    },
    "run_overrides": {
      "$ref": "#/$defs/RunOverrides"
    },
    "schema_version": {
      "const": "effective-config.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_artifact_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Snapshot Artifact Id"
    },
    "source_map": {
      "patternProperties": {
        "^\\S(?:.*\\S)?$": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "type": "string"
        }
      },
      "propertyNames": {
        "maxLength": 512,
        "minLength": 1
      },
      "title": "Source Map",
      "type": "object"
    },
    "system_policy_version": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "System Policy Version",
      "type": "string"
    },
    "workflow_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Workflow Id",
      "type": "string"
    },
    "workflow_version": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Workflow Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "effective_config_id",
    "system_policy_version",
    "domain_profile_id",
    "domain_profile_version",
    "channel_profile_id",
    "channel_profile_version",
    "workflow_id",
    "workflow_version",
    "run_overrides",
    "config_hash"
  ],
  "title": "EffectiveConfig",
  "type": "object",
  "x-contract-schema-version": "effective-config.v1"
}
