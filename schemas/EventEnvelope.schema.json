{
  "$defs": {
    "EventType": {
      "description": "Canonical lowercase-dot event names from ``registries/events.yaml``.",
      "enum": [
        "workflow.created",
        "workflow.started",
        "stage.ready",
        "stage.claimed",
        "stage.started",
        "stage.succeeded",
        "stage.failed",
        "stage.unknown",
        "artifact.created",
        "artifact.invalidated",
        "quality.requested",
        "quality.evaluated",
        "repair.requested",
        "human_review.requested",
        "human_review.completed",
        "workflow.paused",
        "workflow.resumed",
        "workflow.completed",
        "workflow.failed",
        "publish.requested",
        "publish.completed"
      ],
      "title": "EventType",
      "type": "string"
    },
    "ExtensionObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonValue": {}
  },
  "$id": "urn:pipeline:contract:EventEnvelope",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical serialized event fact, notification, or command.",
  "properties": {
    "attempt_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attempt Id"
    },
    "causation_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "correlation_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Correlation Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "event_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/EventType"
    },
    "payload": {
      "$ref": "#/$defs/ExtensionObject"
    },
    "payload_schema_version": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Payload Schema Version",
      "type": "string"
    },
    "run_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "schema_version": {
      "const": "event-envelope.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "stage_instance_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stage Instance Id"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "correlation_id",
    "payload_schema_version",
    "created_at"
  ],
  "title": "EventEnvelope",
  "type": "object",
  "x-contract-schema-version": "event-envelope.v1"
}
