{
  "$defs": {
    "ArtifactPointerType": {
      "enum": [
        "CURRENT",
        "ACCEPTED",
        "PUBLISHED"
      ],
      "title": "ArtifactPointerType",
      "type": "string"
    }
  },
  "$id": "urn:pipeline:contract:ArtifactPointer",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Selects one artifact version for a logical slot at a point in time.",
  "properties": {
    "active": {
      "default": true,
      "title": "Active",
      "type": "boolean"
    },
    "artifact_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Artifact Id",
      "type": "string"
    },
    "logical_slot": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Logical Slot",
      "type": "string"
    },
    "pointer_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Pointer Id",
      "type": "string"
    },
    "pointer_type": {
      "$ref": "#/$defs/ArtifactPointerType"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "artifact-pointer.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "updated_timestamp_micro": {
      "title": "Updated Timestamp Micro",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "pointer_id",
    "run_id",
    "logical_slot",
    "artifact_id",
    "pointer_type",
    "updated_timestamp_micro"
  ],
  "title": "ArtifactPointer",
  "type": "object",
  "x-contract-schema-version": "artifact-pointer.v2"
}
