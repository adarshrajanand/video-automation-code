{
  "$defs": {
    "CompositionAudioTrackSpec": {
      "additionalProperties": false,
      "description": "An audio track spanning a frame range with optional volume envelope.",
      "properties": {
        "audio_artifact_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Audio Artifact Id",
          "type": "string"
        },
        "audio_track_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Audio Track Id",
          "type": "string"
        },
        "end_frame": {
          "minimum": 1,
          "title": "End Frame",
          "type": "integer"
        },
        "fade_in_frames": {
          "default": 0,
          "minimum": 0,
          "title": "Fade In Frames",
          "type": "integer"
        },
        "fade_out_frames": {
          "default": 0,
          "minimum": 0,
          "title": "Fade Out Frames",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "VOICE",
            "MUSIC",
            "EFFECT",
            "AMBIENCE"
          ],
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "composition-audio-track-spec.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "volume": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Volume",
          "type": "number"
        }
      },
      "required": [
        "schema_version",
        "audio_track_id",
        "kind",
        "start_frame",
        "end_frame",
        "audio_artifact_id"
      ],
      "title": "CompositionAudioTrackSpec",
      "type": "object"
    },
    "CompositionAuthoringSpec": {
      "additionalProperties": false,
      "description": "Authoring metadata and deterministic fingerprint inputs.",
      "properties": {
        "effective_config_hash": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Effective Config Hash",
          "type": "string"
        },
        "fonts_version": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Fonts Version",
          "type": "string"
        },
        "frame_rate": {
          "minimum": 1,
          "title": "Frame Rate",
          "type": "integer"
        },
        "input_artifact_hashes": {
          "patternProperties": {
            "^\\S+$": {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 256,
            "minLength": 1
          },
          "title": "Input Artifact Hashes",
          "type": "object"
        },
        "input_artifact_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "title": "Input Artifact Ids",
          "type": "array"
        },
        "random_seed": {
          "minimum": 0,
          "title": "Random Seed",
          "type": "integer"
        },
        "renderer_version": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Renderer Version",
          "type": "string"
        },
        "schema_version": {
          "const": "composition-authoring-spec.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "schema_version_id": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Schema Version Id",
          "type": "string"
        },
        "template_version": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Template Version",
          "type": "string"
        },
        "timebase": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Timebase",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "schema_version_id",
        "effective_config_hash",
        "renderer_version",
        "fonts_version",
        "template_version",
        "timebase",
        "frame_rate",
        "random_seed"
      ],
      "title": "CompositionAuthoringSpec",
      "type": "object"
    },
    "CompositionLayerSpec": {
      "additionalProperties": false,
      "description": "One placed visual, audio, text, caption, or effect layer in a shot.",
      "properties": {
        "asset_instance_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Instance Id"
        },
        "end_frame": {
          "minimum": 1,
          "title": "End Frame",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/LayerKind"
        },
        "layer_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Layer Id",
          "type": "string"
        },
        "payload_artifact_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payload Artifact Id"
        },
        "properties": {
          "$ref": "#/$defs/ExtensionObject"
        },
        "schema_version": {
          "const": "composition-layer-spec.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "z_index": {
          "default": 0,
          "title": "Z Index",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "layer_id",
        "kind",
        "start_frame",
        "end_frame"
      ],
      "title": "CompositionLayerSpec",
      "type": "object"
    },
    "CompositionSceneSpec": {
      "additionalProperties": false,
      "description": "A narration-centered semantic unit with shots and audio.",
      "properties": {
        "audio_track_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "title": "Audio Track Ids",
          "type": "array"
        },
        "narration_artifact_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Narration Artifact Id"
        },
        "order_index": {
          "minimum": 0,
          "title": "Order Index",
          "type": "integer"
        },
        "scene_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Scene Id",
          "type": "string"
        },
        "schema_version": {
          "const": "composition-scene-spec.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "shot_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "title": "Shot Ids",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "scene_id",
        "order_index"
      ],
      "title": "CompositionSceneSpec",
      "type": "object"
    },
    "CompositionSequenceSpec": {
      "additionalProperties": false,
      "description": "A chapter or major section within the editorial hierarchy.",
      "properties": {
        "order_index": {
          "minimum": 0,
          "title": "Order Index",
          "type": "integer"
        },
        "scene_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "title": "Scene Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "composition-sequence-spec.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Sequence Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "sequence_id",
        "order_index"
      ],
      "title": "CompositionSequenceSpec",
      "type": "object"
    },
    "CompositionShotSpec": {
      "additionalProperties": false,
      "description": "A half-open frame range containing ordered visual layers.",
      "properties": {
        "end_frame": {
          "minimum": 1,
          "title": "End Frame",
          "type": "integer"
        },
        "layer_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "title": "Layer Ids",
          "type": "array"
        },
        "order_index": {
          "minimum": 0,
          "title": "Order Index",
          "type": "integer"
        },
        "schema_version": {
          "const": "composition-shot-spec.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "shot_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Shot Id",
          "type": "string"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "shot_id",
        "order_index",
        "start_frame",
        "end_frame"
      ],
      "title": "CompositionShotSpec",
      "type": "object"
    },
    "ExtensionObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonValue": {},
    "LayerKind": {
      "enum": [
        "VIDEO",
        "IMAGE",
        "SHAPE",
        "CHART",
        "CODE",
        "TEXT",
        "CAPTION",
        "AUDIO_VOICE",
        "AUDIO_MUSIC",
        "AUDIO_EFFECT",
        "MASK",
        "TRANSITION"
      ],
      "title": "LayerKind",
      "type": "string"
    }
  },
  "$id": "urn:pipeline:contract:CompositionSpec",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable resolved composition manifest for one cut (render-manifest.v1).",
  "properties": {
    "audio_tracks": {
      "items": {
        "$ref": "#/$defs/CompositionAudioTrackSpec"
      },
      "title": "Audio Tracks",
      "type": "array"
    },
    "authoring": {
      "$ref": "#/$defs/CompositionAuthoringSpec"
    },
    "composition_artifact_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Composition Artifact Id",
      "type": "string"
    },
    "cut_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Cut Id",
      "type": "string"
    },
    "duration_frames": {
      "minimum": 1,
      "title": "Duration Frames",
      "type": "integer"
    },
    "frame_rate": {
      "minimum": 1,
      "title": "Frame Rate",
      "type": "integer"
    },
    "height": {
      "minimum": 1,
      "title": "Height",
      "type": "integer"
    },
    "layers": {
      "items": {
        "$ref": "#/$defs/CompositionLayerSpec"
      },
      "title": "Layers",
      "type": "array"
    },
    "render_profile_hash": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Render Profile Hash",
      "type": "string"
    },
    "render_profile_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Render Profile Id",
      "type": "string"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/CompositionSceneSpec"
      },
      "title": "Scenes",
      "type": "array"
    },
    "schema_version": {
      "const": "render-manifest.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "sequences": {
      "items": {
        "$ref": "#/$defs/CompositionSequenceSpec"
      },
      "title": "Sequences",
      "type": "array"
    },
    "shots": {
      "items": {
        "$ref": "#/$defs/CompositionShotSpec"
      },
      "title": "Shots",
      "type": "array"
    },
    "timebase": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Timebase",
      "type": "string"
    },
    "width": {
      "minimum": 1,
      "title": "Width",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "composition_artifact_id",
    "cut_id",
    "render_profile_id",
    "render_profile_hash",
    "timebase",
    "frame_rate",
    "width",
    "height",
    "duration_frames",
    "authoring"
  ],
  "title": "CompositionSpec",
  "type": "object",
  "x-contract-schema-version": "render-manifest.v1"
}
