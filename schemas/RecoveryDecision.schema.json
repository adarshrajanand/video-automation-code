{
  "$defs": {
    "RecoveryAction": {
      "enum": [
        "RESUME",
        "RETRY",
        "RECONCILE",
        "REGENERATE",
        "WAIT_HUMAN",
        "FAIL"
      ],
      "title": "RecoveryAction",
      "type": "string"
    }
  },
  "$id": "urn:pipeline:contract:RecoveryDecision",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Recorded recovery action for one run and optional failed attempt.",
  "properties": {
    "action": {
      "$ref": "#/$defs/RecoveryAction"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "failed_attempt_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failed Attempt Id"
    },
    "reason_codes": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "pattern": "^\\S(?:.*\\S)?$",
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "recovery_decision_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Recovery Decision Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "recovery-decision.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "target_artifact_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^\\S+$",
        "type": "string"
      },
      "title": "Target Artifact Ids",
      "type": "array"
    },
    "target_stage_instance_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^\\S+$",
        "type": "string"
      },
      "title": "Target Stage Instance Ids",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "recovery_decision_id",
    "run_id",
    "action",
    "created_at"
  ],
  "title": "RecoveryDecision",
  "type": "object",
  "x-contract-schema-version": "recovery-decision.v1"
}
