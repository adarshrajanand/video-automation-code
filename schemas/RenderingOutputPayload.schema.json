{
  "$defs": {
    "ExtensionObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonValue": {}
  },
  "$id": "urn:pipeline:contract:RenderingOutputPayload",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Output payload for the rendering capability.",
  "properties": {
    "chunk_manifest_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^\\S+$",
        "type": "string"
      },
      "title": "Chunk Manifest Ids",
      "type": "array"
    },
    "chunked": {
      "default": false,
      "title": "Chunked",
      "type": "boolean"
    },
    "complete_cut_artifact_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Complete Cut Artifact Id"
    },
    "composition_artifact_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Composition Artifact Id",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/ExtensionObject"
    },
    "render_profile_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Render Profile Id",
      "type": "string"
    },
    "schema_version": {
      "const": "rendering-output.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "composition_artifact_id",
    "render_profile_id"
  ],
  "title": "RenderingOutputPayload",
  "type": "object",
  "x-contract-schema-version": "rendering-output.v1"
}
