{
  "$defs": {
    "ExtensionObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonValue": {}
  },
  "$id": "urn:pipeline:contract:RoutingDecision",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Recorded selection of implementation, provider, model, and fallbacks.",
  "properties": {
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "budget_context": {
      "$ref": "#/$defs/ExtensionObject"
    },
    "candidate_exclusions": {
      "items": {
        "$ref": "#/$defs/ExtensionObject"
      },
      "title": "Candidate Exclusions",
      "type": "array"
    },
    "capability": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Capability",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data_classification": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Data Classification",
      "type": "string"
    },
    "fallback_chain": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "pattern": "^\\S(?:.*\\S)?$",
        "type": "string"
      },
      "title": "Fallback Chain",
      "type": "array"
    },
    "implementation": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Implementation",
      "type": "string"
    },
    "implementation_version": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Implementation Version",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "paid_fallback_authorized": {
      "default": false,
      "title": "Paid Fallback Authorized",
      "type": "boolean"
    },
    "policy_version": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Policy Version",
      "type": "string"
    },
    "provider": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Provider",
      "type": "string"
    },
    "provider_config_hash": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Provider Config Hash",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "pattern": "^\\S(?:.*\\S)?$",
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "routing_decision_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Routing Decision Id",
      "type": "string"
    },
    "schema_version": {
      "const": "routing-decision.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "usage_context": {
      "$ref": "#/$defs/ExtensionObject"
    }
  },
  "required": [
    "schema_version",
    "routing_decision_id",
    "capability",
    "implementation",
    "implementation_version",
    "provider",
    "provider_config_hash",
    "policy_version",
    "attempt",
    "data_classification",
    "created_at"
  ],
  "title": "RoutingDecision",
  "type": "object",
  "x-contract-schema-version": "routing-decision.v1"
}
