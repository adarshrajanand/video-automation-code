{
  "$defs": {
    "ExtensionObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonValue": {}
  },
  "$id": "urn:pipeline:contract:ResolvedArtifactRef",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Resolved reference to an immutable artifact with its hash and URI.",
  "properties": {
    "artifact_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Artifact Type",
      "type": "string"
    },
    "media_metadata": {
      "$ref": "#/$defs/ExtensionObject"
    },
    "media_type": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Media Type"
    },
    "schema_version": {
      "const": "resolved-artifact-ref.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "uri": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Uri",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "artifact_type",
    "uri",
    "sha256",
    "size_bytes"
  ],
  "title": "ResolvedArtifactRef",
  "type": "object",
  "x-contract-schema-version": "resolved-artifact-ref.v1"
}
