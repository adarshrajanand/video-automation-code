{
  "$defs": {
    "EventEnvelope": {
      "additionalProperties": false,
      "description": "Canonical serialized event fact, notification, or command.",
      "properties": {
        "attempt_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt Id"
        },
        "causation_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causation Id"
        },
        "correlation_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Correlation Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "event_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "$ref": "#/$defs/EventType"
        },
        "payload": {
          "$ref": "#/$defs/ExtensionObject"
        },
        "payload_schema_version": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Payload Schema Version",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "schema_version": {
          "const": "event-envelope.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "stage_instance_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage Instance Id"
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "event_type",
        "correlation_id",
        "payload_schema_version",
        "created_at"
      ],
      "title": "EventEnvelope",
      "type": "object"
    },
    "EventType": {
      "description": "Canonical lowercase-dot event names from ``registries/events.yaml``.",
      "enum": [
        "workflow.created",
        "workflow.started",
        "stage.ready",
        "stage.claimed",
        "stage.started",
        "stage.succeeded",
        "stage.failed",
        "stage.unknown",
        "artifact.created",
        "artifact.invalidated",
        "quality.requested",
        "quality.evaluated",
        "repair.requested",
        "human_review.requested",
        "human_review.completed",
        "workflow.paused",
        "workflow.resumed",
        "workflow.completed",
        "workflow.failed",
        "publish.requested",
        "publish.completed"
      ],
      "title": "EventType",
      "type": "string"
    },
    "ExtensionObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonValue": {},
    "OutboxStatus": {
      "enum": [
        "PENDING",
        "CLAIMED",
        "DELIVERED",
        "FAILED"
      ],
      "title": "OutboxStatus",
      "type": "string"
    }
  },
  "$id": "urn:pipeline:contract:OutboxMessage",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Delivery state for one committed event, claimed with a lease.",
  "properties": {
    "available_at": {
      "format": "date-time",
      "title": "Available At",
      "type": "string"
    },
    "claimed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Claimed At"
    },
    "claimed_by": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Claimed By"
    },
    "delivered_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Delivered At"
    },
    "delivery_attempts": {
      "default": 0,
      "minimum": 0,
      "title": "Delivery Attempts",
      "type": "integer"
    },
    "event": {
      "$ref": "#/$defs/EventEnvelope"
    },
    "event_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Event Id",
      "type": "string"
    },
    "lease_expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lease Expires At"
    },
    "outbox_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Outbox Id",
      "type": "string"
    },
    "schema_version": {
      "const": "outbox-message.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/OutboxStatus"
    }
  },
  "required": [
    "schema_version",
    "outbox_id",
    "event_id",
    "event",
    "status",
    "available_at"
  ],
  "title": "OutboxMessage",
  "type": "object",
  "x-contract-schema-version": "outbox-message.v1"
}
