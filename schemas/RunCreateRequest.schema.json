{
  "$defs": {
    "DuplicatePolicy": {
      "enum": [
        "RETURN_EXISTING",
        "REJECT",
        "CREATE_NEW"
      ],
      "title": "DuplicatePolicy",
      "type": "string"
    },
    "RunOverrides": {
      "additionalProperties": false,
      "description": "Caller-supplied changes that still resolve under system policy.",
      "properties": {
        "enabled_optional_stages": {
          "items": {
            "$ref": "#/$defs/StageName"
          },
          "title": "Enabled Optional Stages",
          "type": "array"
        },
        "locale": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locale"
        },
        "max_cost_minor": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Minor"
        },
        "output_profile_ids": {
          "anyOf": [
            {
              "items": {
                "maxLength": 256,
                "minLength": 1,
                "pattern": "^\\S+$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Profile Ids"
        },
        "quality_profile_id": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Profile Id"
        },
        "schema_version": {
          "const": "run-overrides.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "target_duration_seconds": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Duration Seconds"
        },
        "variant_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant Count"
        }
      },
      "required": [
        "schema_version"
      ],
      "title": "RunOverrides",
      "type": "object"
    },
    "StageName": {
      "description": "Canonical stage names from ``registries/stages.yaml``.",
      "enum": [
        "manual_topic",
        "topic_discovery",
        "idea_development",
        "research",
        "script_generation",
        "visual_planning",
        "asset_acquisition",
        "speech_generation",
        "composition",
        "rendering",
        "assembly",
        "short_derivative",
        "technical_content_review",
        "human_approval",
        "publishing",
        "analytics_learning"
      ],
      "title": "StageName",
      "type": "string"
    }
  },
  "$id": "urn:pipeline:contract:RunCreateRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Idempotent request to create a workflow run.",
  "properties": {
    "content_package_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Content Package Id",
      "type": "string"
    },
    "duplicate_policy": {
      "$ref": "#/$defs/DuplicatePolicy",
      "default": "RETURN_EXISTING"
    },
    "effective_config_overrides": {
      "$ref": "#/$defs/RunOverrides"
    },
    "run_key": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Run Key",
      "type": "string"
    },
    "schema_version": {
      "const": "run-create-request.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "workflow_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Workflow Id",
      "type": "string"
    },
    "workflow_version": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Workflow Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_key",
    "workflow_id",
    "workflow_version",
    "content_package_id",
    "effective_config_overrides"
  ],
  "title": "RunCreateRequest",
  "type": "object",
  "x-contract-schema-version": "run-create-request.v1"
}
