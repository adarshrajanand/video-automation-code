{
  "$defs": {
    "ExtensionObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonValue": {}
  },
  "$id": "urn:pipeline:contract:ScriptScene",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A single scene in a script with narration, claims, and visual intents.",
  "properties": {
    "claim_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^\\S+$",
        "type": "string"
      },
      "title": "Claim Ids",
      "type": "array"
    },
    "estimated_duration_seconds": {
      "minimum": 1,
      "title": "Estimated Duration Seconds",
      "type": "integer"
    },
    "metadata": {
      "$ref": "#/$defs/ExtensionObject"
    },
    "narration": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Narration",
      "type": "string"
    },
    "order_index": {
      "minimum": 0,
      "title": "Order Index",
      "type": "integer"
    },
    "scene_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Scene Id",
      "type": "string"
    },
    "schema_version": {
      "const": "script-scene.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "script_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Script Id",
      "type": "string"
    },
    "visual_intent_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^\\S+$",
        "type": "string"
      },
      "title": "Visual Intent Ids",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "scene_id",
    "script_id",
    "order_index",
    "narration",
    "estimated_duration_seconds"
  ],
  "title": "ScriptScene",
  "type": "object",
  "x-contract-schema-version": "script-scene.v1"
}
