{
  "$defs": {
    "ReviewStatus": {
      "enum": [
        "OPEN",
        "ASSIGNED",
        "RESOLVED",
        "EXPIRED",
        "CANCELLED"
      ],
      "title": "ReviewStatus",
      "type": "string"
    }
  },
  "$id": "urn:pipeline:contract:HumanReview",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Durable reviewer request tied to exact artifact versions.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "gate_id": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gate Id"
    },
    "reason_codes": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "pattern": "^\\S(?:.*\\S)?$",
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "requested_action": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Requested Action",
      "type": "string"
    },
    "resolved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolved At"
    },
    "review_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Review Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "human-review.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "stage_instance_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stage Instance Id"
    },
    "status": {
      "$ref": "#/$defs/ReviewStatus"
    },
    "target_artifact_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^\\S+$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Target Artifact Ids",
      "type": "array"
    },
    "target_hashes": {
      "patternProperties": {
        "^\\S+$": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "propertyNames": {
        "maxLength": 256,
        "minLength": 1
      },
      "title": "Target Hashes",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "review_id",
    "run_id",
    "target_artifact_ids",
    "requested_action",
    "status",
    "created_at"
  ],
  "title": "HumanReview",
  "type": "object",
  "x-contract-schema-version": "human-review.v1"
}
