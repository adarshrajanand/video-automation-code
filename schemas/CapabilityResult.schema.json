{
  "$defs": {
    "CapabilityResultStatus": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "UNKNOWN"
      ],
      "title": "CapabilityResultStatus",
      "type": "string"
    },
    "ExtensionObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "FailureCategory": {
      "description": "Stable failure categories from the canonical failure-code registry.",
      "enum": [
        "VALIDATION",
        "AUTHENTICATION",
        "AUTHORIZATION",
        "RATE_LIMIT",
        "QUOTA",
        "TRANSIENT",
        "PERMANENT",
        "UNKNOWN_OUTCOME",
        "MEDIA",
        "QUALITY",
        "BUDGET",
        "CONFIGURATION",
        "HUMAN_REVIEW",
        "POLICY",
        "INTERNAL"
      ],
      "title": "FailureCategory",
      "type": "string"
    },
    "FailureCode": {
      "description": "Namespaced failure codes registered for recovery decisions.",
      "enum": [
        "EXEC.VALIDATION",
        "EXEC.AUTHENTICATION",
        "EXEC.AUTHORIZATION",
        "EXEC.RATE_LIMIT",
        "EXEC.QUOTA",
        "EXEC.TRANSIENT_PROVIDER",
        "EXEC.PERMANENT_PROVIDER",
        "EXEC.INTERNAL",
        "EXEC.TIMEOUT_UNKNOWN",
        "MEDIA.DECODE_ERROR",
        "MEDIA.OUTPUT_PROFILE",
        "MEDIA.TIMELINE_INVALID",
        "MEDIA.TECHNICAL_INTEGRITY",
        "QUALITY.SCHEMA_INVALID",
        "QUALITY.GENERIC",
        "QUALITY.UNSUPPORTED_CLAIM",
        "QUALITY.NUMERIC_CONTRADICTION",
        "QUALITY.TTS_OMISSION",
        "QUALITY.TTS_PRONUNCIATION",
        "QUALITY.VISUAL_MISMATCH",
        "QUALITY.MISSING_ASSET",
        "QUALITY.PROVENANCE_MISSING",
        "QUALITY.CAPTION_OVERFLOW",
        "QUALITY.AUDIO_DECODE",
        "MEDIA.RENDER_CORRUPT",
        "MEDIA.AUDIO_VIDEO_DRIFT",
        "QUALITY.REPEATED_FAILURE",
        "RIGHTS.LICENSE_UNCERTAIN",
        "HUMAN.REVIEW_REQUIRED",
        "POLICY.BUDGET_EXCEEDED",
        "POLICY.PROHIBITED_CONTENT",
        "CONFIG.UNKNOWN_STAGE"
      ],
      "title": "FailureCode",
      "type": "string"
    },
    "JsonValue": {},
    "NormalizedError": {
      "additionalProperties": false,
      "description": "Provider- and stage-neutral failure explanation.\n\n``category`` must agree with the canonical category registered for\n``code``. Reconciliation is explicit so unknown external outcomes cannot be\nmistaken for clean failures.",
      "properties": {
        "category": {
          "$ref": "#/$defs/FailureCategory"
        },
        "code": {
          "$ref": "#/$defs/FailureCode"
        },
        "message": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Message",
          "type": "string"
        },
        "provider_status": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Status"
        },
        "reconciliation_required": {
          "default": false,
          "title": "Reconciliation Required",
          "type": "boolean"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "safe_details": {
          "$ref": "#/$defs/ExtensionObject"
        },
        "schema_version": {
          "const": "normalized-error.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "default": "MAJOR"
        }
      },
      "required": [
        "schema_version",
        "code",
        "category",
        "retryable",
        "message"
      ],
      "title": "NormalizedError",
      "type": "object"
    },
    "Severity": {
      "description": "Severity used by normalized errors and quality evidence.",
      "enum": [
        "INFO",
        "MINOR",
        "MAJOR",
        "CRITICAL"
      ],
      "title": "Severity",
      "type": "string"
    },
    "UsageRecord": {
      "additionalProperties": false,
      "description": "Observed provider or local implementation usage.",
      "properties": {
        "actual_cost_minor": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Cost Minor"
        },
        "estimated_cost_minor": {
          "default": 0,
          "minimum": 0,
          "title": "Estimated Cost Minor",
          "type": "integer"
        },
        "input_units": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Units"
        },
        "metadata": {
          "$ref": "#/$defs/ExtensionObject"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "output_units": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Units"
        },
        "provider": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Provider",
          "type": "string"
        },
        "runtime_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Seconds"
        },
        "schema_version": {
          "const": "usage.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "provider"
      ],
      "title": "UsageRecord",
      "type": "object"
    }
  },
  "$id": "urn:pipeline:contract:CapabilityResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Returned outcome of exactly one capability attempt.",
  "properties": {
    "artifact_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^\\S+$",
        "type": "string"
      },
      "title": "Artifact Ids",
      "type": "array"
    },
    "capability_execution_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Capability Execution Id",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/ExtensionObject"
    },
    "normalized_error": {
      "anyOf": [
        {
          "$ref": "#/$defs/NormalizedError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "capability-result.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/CapabilityResultStatus"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/UsageRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "capability_execution_id",
    "status"
  ],
  "title": "CapabilityResult",
  "type": "object",
  "x-contract-schema-version": "capability-result.v1"
}
