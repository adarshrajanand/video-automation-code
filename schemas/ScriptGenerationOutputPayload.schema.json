    },
    "scene_count": {
      "minimum": 1,
      "title": "Scene Count",
      "type": "integer"
    },
    "scene_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^\\S+$",
        "type": "string"
      },
      "title": "Scene Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "script-generation-output.v1",
