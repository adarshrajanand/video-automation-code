    "total_estimated_duration_seconds": {
      "minimum": 1,
      "title": "Total Estimated Duration Seconds",
      "type": "integer"
    },
    "visual_intent_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^\\S+$",
