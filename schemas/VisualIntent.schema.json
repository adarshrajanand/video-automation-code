{
  "$defs": {
    "ExtensionObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonValue": {}
  },
  "$id": "urn:pipeline:contract:VisualIntent",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Visual intent for a scene or shot, describing what should be shown.",
  "properties": {
    "description": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Description",
      "type": "string"
    },
    "elements": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "pattern": "^\\S(?:.*\\S)?$",
        "type": "string"
      },
      "title": "Elements",
      "type": "array"
    },
    "metadata": {
      "$ref": "#/$defs/ExtensionObject"
    },
    "overlays": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "pattern": "^\\S(?:.*\\S)?$",
        "type": "string"
      },
      "title": "Overlays",
      "type": "array"
    },
    "provenance_requirements": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "pattern": "^\\S(?:.*\\S)?$",
        "type": "string"
      },
      "title": "Provenance Requirements",
      "type": "array"
    },
    "purpose": {
      "enum": [
        "ESTABLISHING",
        "ILLUSTRATIVE",
        "EVIDENCE",
        "DATA_VIZ",
        "TRANSITION",
        "BRANDING"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "scene_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Scene Id",
      "type": "string"
    },
    "schema_version": {
      "const": "visual-intent.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "timing_hint_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Timing Hint Seconds"
    },
    "visual_intent_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Visual Intent Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "visual_intent_id",
    "scene_id",
    "description",
    "purpose"
  ],
  "title": "VisualIntent",
  "type": "object",
  "x-contract-schema-version": "visual-intent.v1"
}
