{
  "$defs": {
    "ExtensionObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonValue": {}
  },
  "$id": "urn:pipeline:contract:SpeechGenerationOutputPayload",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Output payload for the speech_generation capability.",
  "properties": {
    "master_audio_artifact_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Master Audio Artifact Id",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/ExtensionObject"
    },
    "narration_text_hashes": {
      "patternProperties": {
        "^\\S+$": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "propertyNames": {
        "maxLength": 256,
        "minLength": 1
      },
      "title": "Narration Text Hashes",
      "type": "object"
    },
    "sample_rate": {
      "default": 24000,
      "minimum": 1,
      "title": "Sample Rate",
      "type": "integer"
    },
    "scene_audio_artifact_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^\\S+$",
        "type": "string"
      },
      "title": "Scene Audio Artifact Ids",
      "type": "array"
    },
    "scene_count": {
      "minimum": 1,
      "title": "Scene Count",
      "type": "integer"
    },
    "schema_version": {
      "const": "speech-generation-output.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "speech_manifest_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Speech Manifest Id",
      "type": "string"
    },
    "total_duration_seconds": {
      "minimum": 1,
      "title": "Total Duration Seconds",
      "type": "integer"
    },
    "voice_config_hash": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Voice Config Hash",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "speech_manifest_id",
    "master_audio_artifact_id",
    "voice_config_hash",
    "total_duration_seconds",
    "scene_count"
  ],
  "title": "SpeechGenerationOutputPayload",
  "type": "object",
  "x-contract-schema-version": "speech-generation-output.v1"
}
